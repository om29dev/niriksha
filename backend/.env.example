# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=iot_dashboard
DB_MIN_POOL_SIZE=2
DB_MAX_POOL_SIZE=10

# Ingestion Batch Flush Settings
BATCH_FLUSH_INTERVAL_MS=300
BATCH_BUFFER_MAX_SIZE=50

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Ollama AI Configuration & Markdown Logging
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
SAVE_AI_MARKDOWN=true
AI_MARKDOWN_DIR=data/ai_logs

# Serial Hardware Telemetry Configuration
SERIAL_PORT=
SERIAL_BAUD=115200

# Industrial MQTT Broker Configuration
MQTT_ENABLED=true
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC=niriksha/poles/+/telemetry
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=niriksha_backend_ingestor
