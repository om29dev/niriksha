# ==============================================================================
# NIRIKSHA - Smart IoT Mesh Telemetry & Hazard Monitoring System
# Root .gitignore
# ==============================================================================

# Operating System & IDE metadata
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Environment Variables & Secrets
.env
.env.*
*.env

# Local Databases
*.db
*.sqlite
*.sqlite3

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
dist/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Node.js & Vite Frontend
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*

# Microcontroller & Arduino Firmware
*.hex
*.bin
*.elf
.pio/

# Logs & AI Generated Transcripts
logs/
*.log
backend/data/ai_logs/*.md
!backend/data/ai_logs/.gitkeep
# Generated Docs Build Artifacts
api_docs_dist/
